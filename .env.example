PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=reminder_app_dev
DB_NAME_TEST=reminder_app_test

# JWT secrets - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Firebase Cloud Messaging (service account) - PLACEHOLDERS ONLY.
# Get these from Firebase Console > Project settings > Service accounts >
# "Generate new private key". Keep the real values out of source control.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=15000
SCHEDULER_BATCH_SIZE=50
SCHEDULER_LEASE_MS=120000
SCHEDULER_STALE_AFTER_MS=3600000
SCHEDULER_MAX_ATTEMPTS=5
RECURRENCE_HORIZON_DAYS=30

DEFAULT_TIMEZONE=Asia/Kolkata

# Bootstrap admin (used once by `npm run migrate`)
SEED_ADMIN_EMAIL=admin@reminder.local
SEED_ADMIN_PASSWORD=Admin@12345
